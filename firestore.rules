rules_version = '2';

// Ositos Fitness: cada dúo (2 personas) vive en duos/{duoId} y solo lo leen/escriben sus 2 miembros.
// Cada persona tiene un PIN propio (pins/{pin}); poniendo el PIN del otro se crea el dúo.
service cloud.firestore {
  match /databases/{database}/documents {

    // OPCIONAL: limitá quién puede usar la app a una lista de cuentas de Google.
    // Reemplazá "return true;" por:
    //   return request.auth.token.email in ['vos@gmail.com', 'tu.pareja@gmail.com', 'amiga@gmail.com'];
    function emailAllowed() {
      return true;
    }

    function signedIn() {
      return request.auth != null && emailAllowed();
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function duoDoc(id) {
      return /databases/$(database)/documents/duos/$(id);
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function ownsId(id) {
      return id.matches(request.auth.uid + '_.*');
    }

    // ---------- Usuarios y PINs ----------

    match /users/{uid} {
      // Te podés leer a vos, y a quien comparte dúo con vos.
      allow get: if signedIn() && (
        request.auth.uid == uid
        || (resource.data.duoId != null
            && get(userPath(request.auth.uid)).data.duoId == resource.data.duoId)
      );

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.duoId == null
        && request.resource.data.pin is string;

      allow update: if signedIn() && (
        // Vos: el PIN no cambia; el dúo solo se asigna si estabas libre y sos miembro del dúo nuevo.
        (
          request.auth.uid == uid
          && request.resource.data.pin == resource.data.pin
          && (
            request.resource.data.duoId == resource.data.duoId
            || (resource.data.duoId == null
                && request.auth.uid in getAfter(duoDoc(request.resource.data.duoId)).data.members)
          )
        )
        ||
        // Tu compañero/a te empareja: solo si estabas libre y el dúo nuevo es de ustedes dos.
        (
          request.auth.uid != uid
          && resource.data.duoId == null
          && onlyChanges(['duoId'])
          && uid in getAfter(duoDoc(request.resource.data.duoId)).data.members
          && request.auth.uid in getAfter(duoDoc(request.resource.data.duoId)).data.members
        )
      );

      allow delete: if false;
    }

    match /pins/{pin} {
      // Cualquiera con sesión puede buscar un PIN (para emparejar).
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.duoId == null
        && pin.matches('^[A-Z0-9]{6}$');

      allow update: if signedIn() && (
        // El dueño puede cambiar su nombre visible.
        (resource.data.uid == request.auth.uid && onlyChanges(['name']))
        ||
        // Al emparejar: queda marcado con el dúo que se le asignó a su dueño.
        (
          resource.data.duoId == null
          && onlyChanges(['duoId'])
          && getAfter(userPath(resource.data.uid)).data.duoId == request.resource.data.duoId
        )
      );

      allow delete: if false;
    }

    // ---------- Dúos ----------

    match /duos/{duoId} {

      function isMember() {
        return signedIn() && request.auth.uid in get(duoDoc(duoId)).data.members;
      }

      allow get: if signedIn() && request.auth.uid in resource.data.members;

      // Crear un dúo: exactamente 2 personas distintas (una sos vos), y en la misma operación
      // las dos quedan apuntando a este dúo (las reglas de users/ exigen que estuvieran libres).
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && getAfter(userPath(request.resource.data.members[0])).data.duoId == duoId
        && getAfter(userPath(request.resource.data.members[1])).data.duoId == duoId;

      // Miembros: pueden editar listas y marcadores, pero nunca la lista de miembros.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      allow delete: if false;

      match /profiles/{uid} {
        allow read: if isMember();
        allow create, update: if isMember() && request.auth.uid == uid;
        allow delete: if false;
      }

      match /days/{dayId} {
        allow read: if isMember();
        allow create, update: if isMember() && ownsId(dayId)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if false;
      }

      match /weights/{weightId} {
        allow read: if isMember();
        allow create, update: if isMember() && ownsId(weightId)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isMember() && ownsId(weightId);
      }

      match /logs/{logId} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.uid == request.auth.uid;
        // Reaccionar a registros (propios o del otro): solo tu propia reacción.
        allow update: if isMember()
          && onlyChanges(['reactions'])
          && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys()
               .hasOnly([request.auth.uid]);
        allow delete: if isMember() && resource.data.uid == request.auth.uid;
      }

      match /weeks/{weekId} {
        allow read, write: if isMember();
      }

      match /pokes/{pokeId} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.from == request.auth.uid
          && request.resource.data.delivered == false;
        // Solo quien recibe el pinchazo puede marcarlo como entregado.
        allow update: if isMember() && resource.data.to == request.auth.uid && onlyChanges(['delivered']);
        allow delete: if false;
      }

      // Contador de fotos de IA: solo lo toca la Cloud Function (Admin SDK).
      match /aiUsage/{id} {
        allow read, write: if false;
      }
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
